# ==========================================================
# WindWise — Renewable Forecast Intelligence Environment Config
# ==========================================================

# Frontend Environment Variables (Vite SPA)
# Base URL of the backend FastAPI service.
# Leave blank for local development proxy (/api/* -> http://127.0.0.1:8001).
# In production on Vercel, set to your hosted FastAPI endpoint (e.g. https://api.windwise.energy).
VITE_API_BASE_URL=""

# Backend Environment Variables (Python FastAPI)
ELEXON_API_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
DEFAULT_CUTOFF_HOUR=11
DEFAULT_CUTOFF_MINUTE=0
REQUEST_TIMEOUT_SECONDS=20.0
MAX_RETRIES=3
CACHE_TTL_SECONDS=3600
PORT=8000
