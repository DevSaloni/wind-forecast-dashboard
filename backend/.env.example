# WindWise Backend Environment Variables
PROJECT_NAME="WindWise — Renewable Forecast Intelligence"
VERSION="1.0.0"

# Elexon BMRS API Base URL
ELEXON_API_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"

# Standard GB Day-Ahead Wholesale Power Market Auction Cutoff (EPEX SPOT / Nord Pool GB)
DEFAULT_CUTOFF_HOUR=11
DEFAULT_CUTOFF_MINUTE=0

# Timeouts & Cache
REQUEST_TIMEOUT_SECONDS=20.0
MAX_RETRIES=3
CACHE_TTL_SECONDS=3600
PORT=8000
